# ─── REQUIRED ──────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAA_your_botfather_token
DATABASE_URL=postgresql://user:password@host:5432/lumira

# ─── AI (Groq) — /ai and /roast become live streaming experiences ──────────
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.1-8b-instant

# ─── OWNERSHIP ─────────────────────────────────────────────────────────────
GLOBAL_OWNER_ID=7728424218

# ─── RUN MODE ──────────────────────────────────────────────────────────────
# Leave WEBHOOK_URL empty for polling (dev), set it for production webhooks.
# WEBHOOK_URL=https://your-domain.example
# PORT=8443
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_SECRET=random-long-string
# RUN_MODE=polling

# ─── FEATURE TOGGLES (all features auto-degrade gracefully anyway) ─────────
# ENABLE_RICH_MESSAGES=1     # Bot API 10.1 Rich Messages
# ENABLE_EPHEMERAL=1         # Bot API 10.2 user-private group replies
# ENABLE_DRAFTS=1            # Bot API 9.3 native streaming previews (DM)
# ENABLE_EFFECTS=1           # 🎉🔥 message effects on big moments
# ENABLE_REACTIONS=1         # bot reacts to key messages

# TZ=Asia/Kolkata
